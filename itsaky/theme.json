                "scope": "string, support.constant, constant, comment.line.documentation, comment.block.documentation",
                "settings": {
                    "foreground": "#8bc34a"
                }
            },
            {
                "scope": "invalid",
                "settings": {
                    "foreground": "#f44336"
                }
