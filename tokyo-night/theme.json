{
    "$schema": "https://raw.githubusercontent.com/Xed-Editor/Theme-Template/refs/heads/main/schema/schema.json",
    "dark": {
        "baseColors": {
            "primary": "#7aa2f7",
            "onPrimary": "#1a1b26",
            "primaryContainer": "#3b4261",
            "onPrimaryContainer": "#c0caf5",
            "secondary": "#bb9af7",
            "onSecondary": "#1a1b26",
            "secondaryContainer": "#4c3a6a",
            "onSecondaryContainer": "#e0def4",
            "tertiary": "#73daca",
            "onTertiary": "#1a1b26",
            "tertiaryContainer": "#2d4f4a",
            "onTertiaryContainer": "#b4f9f8",
            "error": "#f7768e",
            "errorContainer": "#592b33",
            "onError": "#1a1b26",
            "onErrorContainer": "#f7768e",
            "background": "#1a1b26",
            "onBackground": "#c0caf5",
            "surface": "#1a1b26",
            "onSurface": "#c0caf5",
            "surfaceVariant": "#24283b",
            "onSurfaceVariant": "#565f89",
            "outline": "#414868",
            "inverseOnSurface": "#1a1b26",
            "inverseSurface": "#c0caf5",
            "inversePrimary": "#7aa2f7",
            "surfaceTint": "#7aa2f7",
            "outlineVariant": "#2d3a5c",
            "scrim": "#000000"
        },
        "terminalColors": {
            "cursor": "#c0caf5",
            "color0": "#414868",
            "color1": "#f7768e",
            "color2": "#9ece6a",
            "color3": "#e0af68",
            "color4": "#7aa2f7",
            "color5": "#bb9af7",
            "color6": "#7dcfff",
            "color7": "#c0caf5",
            "color8": "#565f89",
            "color9": "#f7768e",
            "color10": "#9ece6a",
            "color11": "#e0af68",
            "color12": "#7aa2f7",
            "color13": "#bb9af7",
            "color14": "#7dcfff",
            "color15": "#c0caf5"
        },
        "editorColors": {
            "whole_background": "#1a1b26",
            "text_normal": "#c0caf5",
            "current_line": "#24283b",
            "line_number": "#414868",
            "line_number_current": "#c0caf5",
            "line_number_background": "#1a1b26",
            "selected_text_background": "#3b4261",
            "selection_handle": "#7aa2f7",
            "selection_insert": "#7aa2f7",
            "non_printable_char": "#565f89",
            "line_divider": "#2d3a5c",
            "side_block_line": "#414868",
            "scroll_bar_thumb": "#3b4261",
            "scroll_bar_thumb_pressed": "#565f89",
            "scroll_bar_track": "#1a1b26",
            "completion_wnd_background": "#24283b",
            "completion_wnd_corner": "#1a1b26",
            "completion_wnd_item_current": "#3b4261",
            "completion_wnd_text_matched": "#7aa2f7",
            "completion_wnd_text_primary": "#c0caf5",
            "completion_wnd_text_secondary": "#565f89",
            "diagnostic_tooltip_action": "#7aa2f7",
            "diagnostic_tooltip_background": "#24283b",
            "diagnostic_tooltip_brief_msg": "#c0caf5",
            "diagnostic_tooltip_detailed_msg": "#9aa5ce",
            "function_char_background_stroke": "#7aa2f7",
            "hard_wrap_marker": "#414868",
            "highlighted_delimiters_background": "#3b4261",
            "highlighted_delimiters_foreground": "#7dcfff",
            "highlighted_delimiters_underline": "#7dcfff",
            "hover_background": "#24283b",
            "hover_border": "#414868",
            "hover_text_highlighted": "#7aa2f7",
            "hover_text_normal": "#c0caf5",
            "line_number_panel": "#1a1b26",
            "line_number_panel_text": "#c0caf5",
            "matched_text_background": "#3b4261",
            "problem_error": "#f7768e",
            "problem_typo": "#9ece6a",
            "problem_warning": "#e0af68",
            "signature_background": "#24283b",
            "signature_border": "#414868",
            "signature_text_highlighted_parameter": "#7dcfff",
            "signature_text_normal": "#c0caf5",
            "snippet_background_editing": "#3b4261",
            "snippet_background_inactive": "#24283b",
            "snippet_background_related": "#2d3a5c",
            "static_span_background": "#24283b",
            "static_span_foreground": "#565f89",
            "sticky_scroll_divider": "#414868",
            "strikethrough": "#565f89",
            "text_action_window_background": "#24283b",
            "text_action_window_icon_color": "#c0caf5",
            "text_inlay_hint_background": "#24283b",
            "text_inlay_hint_foreground": "#565f89",
            "text_selected": "#c0caf5",
            "underline": "#565f89",
            "block_line": "#1a1b26",
            "block_line_current": "#1a1b26",
            "text_highlight_background": "#3b4261",
            "text_highlight_border": "#7aa2f7",
            "text_highlight_strong_background": "#3b4261",
            "text_highlight_strong_border": "#7aa2f7",
            "matched_text_border": "#7aa2f7",
            "selected_text_border": "#7aa2f7",
            "current_row_border": "#7aa2f7"
        },
        "tokenColors": [
            {
                "scope": "comment",
                "settings": {
                    "foreground": "#565f89",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "string, support.constant, constant, comment.line.documentation, comment.block.documentation, constant.character.escape",
                "settings": {
                    "foreground": "#9ece6a"
                }
            },
            {
                "scope": "invalid",
                "settings": {
                    "foreground": "#f7768e"
                }
            },
            {
                "scope": "keyword, storage, variable.language, constant.language, entity.name.tag, keyword.control, storage.modifier, storage.type",
                "settings": {
                    "foreground": "#bb9af7"
                }
            },
            {
                "scope": "keyword.operator",
                "settings": {
                    "foreground": "#89ddff"
                }
            },
            {
                "scope": "entity.name.function, entity.name.function.call, support.function",
                "settings": {
                    "foreground": "#7aa2f7"
                }
            },
            {
                "scope": "variable.other.object.property, variable.other.member, variable.parameter",
                "settings": {
                    "foreground": "#e0af68"
                }
            },
            {
                "scope": "variable, entity.name.section, entity.name, entity.name.type, entity.name.class, support.type",
                "settings": {
                    "foreground": "#73daca"
                }
            },
            {
                "scope": "entity.other.attribute-name, meta.tag",
                "settings": {
                    "foreground": "#f7768e"
                }
            },
            {
                "scope": "entity, entity.other.inherited-class",
                "settings": {
                    "foreground": "#7dcfff"
                }
            },
            {
                "scope": "constant.numeric, constant.language.boolean",
                "settings": {
                    "foreground": "#ff9e64"
                }
            },
            {
                "scope": "support.type.property-name.json, support.type.property-name.yaml, support.type.property-name.toml",
                "settings": {
                    "foreground": "#bb9af7"
                }
            }
        ]
    }
}