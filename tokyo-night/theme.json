        "tokenColors": [
            {
                "scope": "comment",
                "settings": {
                    "foreground": "#565f89",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "string, support.constant, constant, comment.line.documentation, comment.block.documentation, constant.character.escape",
                "settings": {
                    "foreground": "#9ece6a"
                }
            },
            {
                "scope": "invalid",
                "settings": {
                    "foreground": "#f7768e"
                }
            },
            {
                "scope": "keyword, storage, variable.language, constant.language, entity.name.tag, keyword.control, storage.modifier, storage.type",
                "settings": {
                    "foreground": "#bb9af7"
                }
            },
            {
                "scope": "keyword.operator",
                "settings": {
                    "foreground": "#89ddff"
                }
            },
            {
                "scope": "entity.name.function, entity.name.function.call, support.function",
                "settings": {
                    "foreground": "#7aa2f7"
                }
            },
            {
                "scope": "variable.other.object.property, variable.other.member, variable.parameter",
                "settings": {
                    "foreground": "#e0af68"
                }
            },
            {
                "scope": "variable, entity.name.section, entity.name, entity.name.type, entity.name.class, support.type",
                "settings": {
                    "foreground": "#73daca"
                }
            },
            {
                "scope": "entity.other.attribute-name, meta.tag",
                "settings": {
                    "foreground": "#f7768e"
                }
            },
            {
                "scope": "entity, entity.other.inherited-class",
                "settings": {
                    "foreground": "#7dcfff"
                }
            },
            {
                "scope": "constant.numeric, constant.language.boolean",
                "settings": {
                    "foreground": "#ff9e64"
                }
            },
            {
                "scope": "support.type.property-name.json, support.type.property-name.yaml, support.type.property-name.toml",
                "settings": {
                    "foreground": "#bb9af7"
                }
            }
        ]
    },
