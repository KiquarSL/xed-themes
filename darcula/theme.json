            "completion_wnd_corner": "#2B2B2B",
            "completion_wnd_item_current": "#214283",
            "completion_wnd_text_matched": "#589DF6",
            "completion_wnd_text_primary": "#A9B7C6",
            "completion_wnd_text_secondary": "#808080",
            "diagnostic_tooltip_action": "#589DF6",
            "diagnostic_tooltip_background": "#3C3F41",
            "diagnostic_tooltip_brief_msg": "#A9B7C6",
            "diagnostic_tooltip_detailed_msg": "#A9B7C6",
            "function_char_background_stroke": "#589DF6",
            "hard_wrap_marker": "#3C3F41",
            "highlighted_delimiters_background": "#3C3F41",
            "highlighted_delimiters_foreground": "#CC7832",
            "highlighted_delimiters_underline": "#589DF6",
            "hover_background": "#3C3F41",
            "hover_border": "#3C3F41",
            "hover_text_highlighted": "#589DF6",
            "hover_text_normal": "#A9B7C6",
