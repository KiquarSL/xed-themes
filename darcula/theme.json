            "line_number_panel_text": "#2B2B2B",
            "matched_text_background": "#CC783244",
            "problem_error": "#BC3F3C",
            "problem_typo": "#6A8759",
            "problem_warning": "#CC7832",
            "signature_background": "#3C3F41",
            "signature_border": "#3C3F41",
            "signature_text_highlighted_parameter": "#589DF6",
            "signature_text_normal": "#A9B7C6",
            "snippet_background_editing": "#589DF644",
            "snippet_background_inactive": "#3C3F41",
            "snippet_background_related": "#3C3F41",
            "static_span_background": "#3C3F41",
            "static_span_foreground": "#A9B7C6",
            "sticky_scroll_divider": "#3C3F41",
            "strikethrough": "#808080",
            "text_action_window_background": "#3C3F41",
            "text_action_window_icon_color": "#A9B7C6",
            "text_inlay_hint_background": "#3C3F41",
            "text_inlay_hint_foreground": "#808080",
            "text_selected": "#A9B7C6",
            "underline": "#589DF6",
            "block_line": "#A9B7C6",
            "block_line_current": "#A9B7C6",
            "text_highlight_background": "#589DF640",
            "text_highlight_border": "#589DF6",
            "text_highlight_strong_background": "#9876AA40",
            "text_highlight_strong_border": "#9876AA",
            "matched_text_border": "#CC7832",
            "selected_text_border": "#589DF6",
            "current_row_border": "#589DF6"
        },
        "tokenColors": [
            {
                "scope": "comment",
                "settings": {
                    "foreground": "#808080",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "keyword, storage, variable.language, constant.language, entity.name.tag",
                "settings": {
                    "foreground": "#CC7832"
                }
            },
            {
                "scope": "keyword.operator",
                "settings": {
                    "foreground": "#CC7832"
                }
            },
            {
                "scope": "string",
                "settings": {
                    "foreground": "#6A8759"
                }
            },
            {
                "scope": "constant.numeric, constant.character, support.constant",
                "settings": {
                    "foreground": "#589DF6"
                }
            },
            {
                "scope": "entity.name.function, entity.name.function.call",
                "settings": {
                    "foreground": "#FFC66D"
                }
            },
            {
                "scope": "entity.name.type, entity.name.type.class, entity.name.type.struct, entity.name.type.enum, entity.name.type.interface, entity.name.type.trait, entity.name.type.union, support.class",
                "settings": {
                    "foreground": "#FFC66D"
                }
            },
            {
                "scope": "variable, entity.name.section, entity.name.namespace, meta",
                "settings": {
                    "foreground": "#A9B7C6"
                }
            },
            {
                "scope": "variable.other.field",
                "settings": {
                    "foreground": "#CC7832"
                }
            },
            {
                "scope": "entity.other.attribute-name",
                "settings": {
                    "foreground": "#9876AA"
                }
            },
            {
                "scope": "support.function, support.function.builtin, support.function.magic, support.other.attribute.cpp",
                "settings": {
                    "foreground": "#FFC66D"
                }
            },
            {
                "scope": "invalid",
                "settings": {
                    "foreground": "#BC3F3C"
                }
            },
            {
                "scope": "punctuation",
                "settings": {
                    "foreground": "#A9B7C6"
                }
            }
        ],
        "terminalColors": {
            "cursor": "#A9B7C6",
            "color0": "#3C3F41",
            "color1": "#BC3F3C",
            "color2": "#6A8759",
            "color3": "#CC7832",
            "color4": "#589DF6",
            "color5": "#9876AA",
            "color6": "#629755",
            "color7": "#A9B7C6",
            "color8": "#808080",
            "color9": "#BC3F3C",
            "color10": "#6A8759",
            "color11": "#CC7832",
            "color12": "#589DF6",
            "color13": "#9876AA",
            "color14": "#629755",
            "color15": "#A9B7C6",
            "color16": "#CC7832",
            "color17": "#629755",
            "color18": "#2B2B2B",
            "color19": "#3C3F41",
            "color20": "#808080",
            "color21": "#A9B7C6"
        }
    }
}