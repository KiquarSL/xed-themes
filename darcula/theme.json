            "selected_text_background": "#214283",
            "selection_handle": "#589DF6",
            "selection_insert": "#589DF6",
            "non_printable_char": "#3C3F41",
            "line_divider": "#3C3F41",
            "side_block_line": "#808080",
            "scroll_bar_thumb": "#3C3F41",
            "scroll_bar_thumb_pressed": "#606366",
            "scroll_bar_track": "#2B2B2B",
